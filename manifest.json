{
    "manifest_version": 3,
    "name": "Image Downloader",
    "version": "2.1",
    "description": "Guided media collector for scanning, filtering, selecting, and downloading images and videos from the active page.",
    "permissions": [
      "activeTab",
      "declarativeNetRequestWithHostAccess",
      "downloads",
      "scripting",
      "storage"
    ],
    "host_permissions": [
      "https://i.pximg.net/*"
    ],
    "action": {
      "default_popup": "popup.html",
      "default_icon": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
      }
    },
    "background": {
      "service_worker": "background.js"
    },
    "icons": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
